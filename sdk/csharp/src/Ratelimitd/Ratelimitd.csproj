<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Ratelimitd</AssemblyName>
    <RootNamespace>Ratelimitd</RootNamespace>
    <PackageId>Phineup.Ratelimitd</PackageId>
    <Version>0.1.0</Version>
    <Description>.NET client for the ratelimitd rate limiting sidecar</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/phineup/ratelimitd</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/phineup/ratelimitd</PackageProjectUrl>
    <PackageTags>rate-limit;ratelimit;ratelimitd;sidecar</PackageTags>
    <Authors>ratelimitd contributors</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
