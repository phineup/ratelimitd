{
  "name": "@phineup/ratelimitd",
  "version": "0.1.0",
  "description": "TypeScript/JavaScript client for the ratelimitd rate limiting sidecar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phineup/ratelimitd.git",
    "directory": "sdk/typescript"
  },
  "keywords": ["rate-limit", "ratelimit", "ratelimitd", "sidecar"],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.cts", "default": "./dist/cjs/index.cjs" }
    }
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/rename-cjs.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .build/test/client.test.js .build/test/integration.test.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
